# -----------------------------------------------------------------------------
# 3xCodz Management System - example environment file
# Copy to `.env` (backend) and fill in real values. Never commit real secrets.
# -----------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=5000
LOG_LEVEL=info

# Database (MySQL 8, local / Linode loopback only)
DATABASE_URL="mysql://3xcode:CHANGE_ME@127.0.0.1:3306/3xcode_db"
SHADOW_DATABASE_URL="mysql://3xcode:CHANGE_ME@127.0.0.1:3306/3xcode_shadow"

# Security (sessions are opaque random tokens; there is no JWT signing key)
SESSION_TTL_HOURS=168
BCRYPT_ROUNDS=12

# CORS / links
FRONTEND_URL=https://yourdomain.com
CORS_ORIGIN=https://yourdomain.com

# Uploads (must stay outside any public web root)
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=15

# Seeding - true only on a fresh demo environment. Leave false in production.
SEED_DEMO=false

# SMTP (optional - password reset + invoice/quotation emails need this)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="3xCodz <noreply@yourdomain.com>"

# Discord (optional - webhook URLs are server-side only and never sent to the SPA.
# Prefer configuring per-event webhooks in Settings > Integrations.)
DISCORD_ENABLED=false
DISCORD_WEBHOOK_DEFAULT=

# Google OAuth (optional - "Continue with Google" sign-in / sign-up.
# Create an OAuth 2.0 Client ID (Web application) in Google Cloud Console and add
# the authorized redirect URI:  {FRONTEND_URL}/api/auth/google/callback
# The button is hidden automatically while these are empty.)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Override only if the API is not reachable at {FRONTEND_URL}/api.
# GOOGLE_REDIRECT_URI=https://yourdomain.com/api/auth/google/callback

