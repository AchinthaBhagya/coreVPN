NODE_ENV=development
PORT=5000
DATABASE_URL="mysql://username:password@localhost:3306/3xcode_db"
JWT_SECRET=your_super_secure_jwt_secret_key_change_in_production
JWT_EXPIRE=7d
BCRYPT_ROUNDS=12
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10MB

# Email
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM="3xCode Management <noreply@yourdomain.com>"

# Discord
DISCORD_ENABLED=false
DISCORD_WEBHOOK_URL=
DISCORD_ORDERS_WEBHOOK=
DISCORD_LEADS_WEBHOOK=
DISCORD_PROJECTS_WEBHOOK=
DISCORD_PAYMENTS_WEBHOOK=
DISCORD_TICKETS_WEBHOOK=
